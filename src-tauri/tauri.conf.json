{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonam",
  "version": "0.1.0",
  "identifier": "org.sonam.app",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8096; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Sua biblioteca pessoal de mídia, inteiramente local",
    "category": "Entertainment"
  }
}